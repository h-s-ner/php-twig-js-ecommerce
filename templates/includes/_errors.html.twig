
{% if errors is defined %}
<div class="mt-4">
  {% for error in errors %}
    <div class="container">
      <div class="row">
        <div class="col col-lg-6 col-sm-12 offset-lg-3 ">
          <div class="alert alert-danger" role="alert">
            {{ error }}
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
{% endif %}