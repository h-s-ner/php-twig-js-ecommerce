<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
    <div class="container-fluid px-3 px-lg-5">
        {# Mobile Toggle #}
        <button
            class="navbar-toggler border-0 shadow-none"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#shopNavbar"
            aria-controls="shopNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>
        {# Logo #}
        <a class="navbar-brand mx-auto mx-lg-0" href="/">
            <img
                src="https://placehold.co/150x76/cb1f17/FFF?text=Logo&font=open-sans"
                class="logo rounded rounded-circle"
                alt="Logo"
                width="150"
                height="76"
            >
        </a>
        {# Navigation #}
        <div class="collapse navbar-collapse" id="shopNavbar">
            <ul class="navbar-nav mx-auto align-items-lg-center mt-3 mt-lg-0">
                <li class="nav-item">
                    <a class="nav-link text-dark fw-medium" href="/">
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark fw-medium" href="/products">
                        Products
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-danger fw-bold" href="/action">
                        Special Offers
                        <span class="badge bg-danger ms-1">SALE</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark fw-medium position-relative"
                    href="/cart">
                        <i class="bi bi-cart3 me-1"></i>
                        Cart

                        {% if cart_count is defined and cart_count > 0 %}
                            <span class="cart-count badge bg-danger rounded-pill ms-1">
                                {{ cart_count }}
                            </span>
                        {% endif %}
                    </a>
                </li>

                {% if role is defined and role.value == 'guest' %}
                <li class="nav-item">
                    <a class="nav-link text-dark fw-medium" href="/login">
                        Login
                    </a>
                </li>
                {% endif %}

                {% if role is defined and role.value == 'admin' %}

                <li class="nav-item dropdown">
                    <a
                        class="nav-link dropdown-toggle text-danger fw-bold"
                        href="#"
                        role="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <i class="bi bi-speedometer2 me-1"></i>
                        Admin Panel
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2"
                        style="min-width: 240px;">

                        <li>
                            <h6 class="dropdown-header text-uppercase">
                                Overview
                            </h6>
                        </li>

                        <li>
                            <a class="dropdown-item rounded-2" href="/admin">
                                <i class="bi bi-grid me-2"></i>
                                Dashboard
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <h6 class="dropdown-header text-uppercase">
                                Management
                            </h6>
                        </li>

                        <li>
                            <a class="dropdown-item rounded-2 {% if p_active is defined %}active{% endif %}"
                            href="/admin/products">
                                <i class="bi bi-box-seam me-2"></i>
                                Products
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item rounded-2 {% if pc_active is defined %}active{% endif %}"
                            href="/admin/product_categories">
                                <i class="bi bi-tags me-2"></i>
                                Categories
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item rounded-2 {% if u_active is defined %}active{% endif %}"
                            href="/admin/users">
                                <i class="bi bi-people me-2"></i>
                                Users
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item rounded-2 {% if o_active is defined %}active{% endif %}"
                            href="/admin/orders">
                                <i class="bi bi-bag me-2"></i>
                                Orders
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <h6 class="dropdown-header text-uppercase">
                                Create New
                            </h6>
                        </li>

                        <li>
                            <a class="dropdown-item rounded-2 {% if cp_active is defined %}active{% endif %}"
                            href="/admin/create_product">
                                <i class="bi bi-plus-circle me-2 text-success"></i>
                                Create Product
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item rounded-2 {% if cpc_active is defined %}active{% endif %}"
                            href="/admin/create_product_category">
                                <i class="bi bi-plus-circle me-2 text-success"></i>
                                Create Category
                            </a>
                        </li>
                    </ul>
                </li>
                {% endif %}

                {% if role is defined and (role.value == 'user') %}
                <li class="nav-item">
                    <a class="nav-link text-dark fw-medium" href="/orders">
                        Orders
                    </a>
                </li>
                {% endif %}

                {% if role is defined and (role.value == 'user' or role.value == 'admin') %}
                <li class="nav-item">
                    <a class="nav-link text-dark fw-medium" href="/account">
                        Account
                    </a>
                </li>
                <li class="nav-item">
                    <form action="/logout" method="POST">
                        {{ csrf_input('logout') }}
                        <button
                            class="nav-link text-dark fw-medium border-0 bg-transparent"
                            type="submit"
                            name="logout"
                        >
                            Logout
                        </button>
                    </form>
                </li>
                {% endif %}
            </ul>
            <form class="d-flex mt-3 mt-lg-0" role="search" action="/search">
                <input
                    class="form-control rounded-pill me-2"
                    type="search"
                    placeholder="Search products..."
                    aria-label="Search"
                    name="query"
                >
                <button class="btn btn-dark rounded-pill px-4" type="submit">
                    Search
                </button>
            </form>
        </div>
    </div>
</nav>
