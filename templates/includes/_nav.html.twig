<style>
/* ========================================
   SHOP NAVBAR
   Bootstrap übernimmt:
   - Container
   - Responsive Breakpoints
   - Collapse
   - Dropdown
   - Flex Utilities

   Dieses CSS übernimmt:
   - Design
   - Farben
   - Animationen
   - Icons
   - Typografie
======================================== */

.shop-navbar {
    min-height: 76px;

    background: rgba(255, 255, 255, 0.88);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(0, 0, 0, 0.07);

    transition:
        background .3s ease,
        box-shadow .3s ease;
}

/* Logo */

.shop-logo {
    position: relative;

    color: #111 !important;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 27px;
    font-weight: 600;

    letter-spacing: -1.5px;

    transition: opacity .2s ease;
}

.shop-logo:hover {
    opacity: .65;
}

.shop-logo span {
    position: absolute;
    top: 2px;
    right: -10px;

    font-family: Arial, sans-serif;
    font-size: 8px;

    letter-spacing: 0;
}

/* Navigation */

.shop-nav-link {
    position: relative;

    padding-left: 0 !important;
    padding-right: 0 !important;

    color: #171717 !important;

    font-size: 13px;
    font-weight: 500;

    letter-spacing: .02em;
}

.shop-nav-link::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: 3px;

    width: 0;
    height: 1px;

    background: #111;

    transition: width .25s ease;
}

.shop-nav-link:hover::after,
.shop-nav-link.active::after {
    width: 100%;
}

/* Bootstrap dropdown arrow entfernen/anpassen */

.shop-nav-link.dropdown-toggle::after {
    margin-left: 6px;

    vertical-align: 2px;

    border-top: 4px solid;
    border-right: 3px solid transparent;
    border-left: 3px solid transparent;
}

.shop-nav-link.dropdown-toggle:hover::after {
    width: auto;
}

/* NEW badge */

.new-badge {
    position: absolute;
    top: -4px;
    right: -24px;

    font-size: 7px;
    font-weight: 700;

    color: #999;

    letter-spacing: .05em;
}

/* Sale */

.sale-link {
    color: #d32f2f !important;
}

.sale-link::after {
    background: #d32f2f;
}

/* Dropdown */

.shop-dropdown {
    min-width: 190px;

    margin-top: 14px !important;
    padding: 10px;

    border: 1px solid rgba(0, 0, 0, .07);
    border-radius: 14px;

    background: rgba(255, 255, 255, .96);

    box-shadow:
        0 20px 50px rgba(0, 0, 0, .10);

    animation: dropdownIn .2s ease;
}

@keyframes dropdownIn {
    from {
        opacity: 0;
        transform: translateY(-6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.shop-dropdown .dropdown-item {
    padding: 9px 12px;

    border-radius: 8px;

    color: #222;

    font-size: 13px;

    transition:
        background .2s ease,
        padding-left .2s ease;
}

.shop-dropdown .dropdown-item:hover {
    padding-left: 16px;

    background: #f5f5f5;
}

.shop-dropdown-sale {
    color: #d32f2f !important;
}

/* Icons */

.shop-icon {
    position: relative;

    width: 22px;
    height: 22px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #111;

    text-decoration: none;

    transition:
        opacity .2s ease,
        transform .2s ease;
}

.shop-icon:hover {
    color: #111;

    opacity: .55;

    transform: translateY(-1px);
}

.shop-icon svg {
    width: 21px;
    height: 21px;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.5;

    stroke-linecap: round;
    stroke-linejoin: round;
}

/* Cart badge */

.shop-cart .cart-badge {
    position: absolute;

    top: -7px;
    right: -9px;

    min-width: 16px;
    height: 16px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0 4px;

    border-radius: 50px;

    background: #111;
    color: white;

    font-family: Arial, sans-serif;
    font-size: 8px;
    font-weight: 700;
}

/* Mobile */

.navbar-toggler {
    width: 24px;
}

.navbar-toggler:focus {
    box-shadow: none;
}

.navbar-toggler-icon {
    width: 20px;
    height: 20px;
}

/* Mobile Navigation */

@media (max-width: 991.98px) {

    .shop-navbar {
        min-height: 68px;
    }

    .shop-navbar .container-fluid {
        flex-wrap: wrap;
    }

    .shop-logo {
        font-size: 23px;
    }

    .shop-navbar .navbar-collapse {
        order: 5;

        width: 100%;

        margin-top: 15px;
        padding: 15px 0 20px;

        border-top: 1px solid rgba(0, 0, 0, .06);
    }

    .shop-navbar .navbar-nav {
        gap: 4px !important;
    }

    .shop-nav-link {
        padding: 10px 0 !important;
    }

    .shop-nav-link::after {
        display: none;
    }

    .new-badge {
        position: static;

        margin-left: 5px;
    }

    .shop-dropdown {
        margin-top: 5px !important;

        border: 0;
        box-shadow: none;

        background: #f8f8f8;
    }
}
</style>#}