{% for product in products %}
    <div class="col-6 col-sm-4 col-md-4 col-lg-3 mt-4">
        <div class="card h-100 ">
            <div class="py-2">
            <a class="text-decoration-none text-reset" href="/show/{{product.id|escape}}" title="show">
                 <img src="{{asset('images')}}/{% if product.image %}{{ product.image }}{% else %}default.png{% endif %}"
                    class="card-img-top cover"
                    alt="..."
                    style="object-fit: cover; max-height:250px">
             </a>
            </div>
            <div class="card-body">
        <p title="{{ product.name|escape }}" class="card-title text-truncate d-inline-block"
            style="font-family:Montserrat,sans-serif; max-width: 100%">{{ product.name|escape }}</p>
                <p class="card-text d-flex justify-content-between">
                    <span>Price: {{ product.price|escape}}€</span>
                    <span>Stock: {{ product.stock|escape}}</span>
                </p>
            </div>
        </div>
    </div>
{% endfor %}
