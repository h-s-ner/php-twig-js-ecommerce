{% extends 'base.html.twig' %}

{% block main %}

<div class="container-xxl mt-4 p-2 p-md-5 position-relative">
    <div class="row">

            {#{% include 'includes/_products.html.twig' with { products } %}#}

        {#
            TO DO
            <aside id="order-aside" class="mt-4 card col-md-2 d-none d-md-block order-block position-sticky vh-100">Your Order </aside>
        #}
    </div>
    <div id="newest-product-carousel" class="carousel slide">

        <div class="carousel-inner">

            {% for productGroup in products|batch(4) %}
                <div class="carousel-item {% if loop.first %}active{% endif %}">

                    <div class="container mt-4">
                        <div class="row">

                            {% for product in productGroup %}
                                <div class="col-12 col-sm-6 col-md-3 mt-4">
                                    <div class="card h-100 position-relative">
                                            <span class="new-cloud-badge">
                                                NEW
                                            </span>
                                        <div class="">
                                            <a href="/show?id={{ product.id }}"
                                                class="w-100"
                                                title="Show"
                                            >
                                                <img src="{{asset('images')}}/{% if product.image %}{{ product.image }}{% else %}default.png{% endif %}"
                                                    class="card-img-top cover"
                                                    alt="{{ product.description|default(product.name) }}"
                                                    style="object-fit: cover; max-height:250px"
                                                    loading="lazy"
                                                >
                                            </a>
                                        </div>

                                        <div class="card-body">

                                            <p class="card-title fw-bold text-truncate"
                                            title="{{ product.name }}">
                                                {{ product.name }}
                                            </p>

                                            <p class="card-title mb-0">
                                                Price: {{ product.price }}$
                                            </p>

                                            <p class="card-title">
                                                Stock: {{ product.stock }}
                                            </p>

                                            

                                        </div>
                                    </div>
                                </div>
                            {% endfor %}

                        </div>
                    </div>

                </div>
            {% endfor %}

        </div>

        <button
            class="carousel-control-prev justify-content-start"
            type="button"
            data-bs-target="#newest-product-carousel"
            data-bs-slide="prev">

            <span
                class="bi bi-arrow-left-circle text-danger fs-1"
                aria-hidden="true">
            </span>

            <span class="visually-hidden">Previous</span>
        </button>

        <button
            class="carousel-control-next justify-content-end"
            type="button"
            data-bs-target="#newest-product-carousel"
            data-bs-slide="next">

            <span
                class="bi bi-arrow-right-circle text-danger fs-1"
                aria-hidden="true">
            </span>

            <span class="visually-hidden">Next</span>
        </button>

        </div>
 </div>
<style>
    .new-cloud-badge {

        position: absolute;
        top:-12px;
        right: -10px;
        z-index: 2;

        background: #dc3545;
        color: white;
        font-size: 1rem;
        font-weight: bold;

        padding: 13px 12px;
        border-radius: 20% 50%;
        border: 4px solid #f0ed2d;
        transform: rotate(12deg);
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
    }
</style>
{% endblock main %}